# Copy to .env (`pnpm infra:up` does this automatically). Local development values only.
# Never commit .env or real credentials.

# --- PostgreSQL ---
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=papertrail
POSTGRES_PORT=5432
DATABASE_URL=postgresql://papertrail:change-me-local-only@localhost:5432/papertrail

# --- RabbitMQ ---
RABBITMQ_USER=papertrail
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
AMQP_URL=amqp://papertrail:change-me-local-only@localhost:5672

# --- File storage ---
# Uploaded files go to this directory (relative to apps/api when run with pnpm). Single host only. To use an
# S3-compatible store instead, remove STORAGE_DIR and set the S3_* values below.
STORAGE_DIR=../../.data/files

# --- MinIO (optional, S3 mode: `docker compose --profile s3 up -d`; its image may no longer be pullable) ---
MINIO_ROOT_USER=papertrail
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=papertrail-files

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Worker: RFC 3161 anchoring ---
# Comma-separated TSA endpoints, tried in order. Intentionally empty: pick providers yourself and verify
# their terms of service, rate limits and availability first (docs/OPEN_DECISIONS.md D1). For an offline
# demo, run `pnpm --filter @paper-trail/worker mock-tsa` and use the values it prints (untrusted, demo only).
TSA_URLS=
# Optional PEM bundle with the TSA's root/intermediate certificates; without it the chain is not verified.
TSA_CA_CERTS=
TSA_TIMEOUT_MS=10000
ANCHOR_INTERVAL_HOURS=6

# --- API: object storage credentials (development reuses the MinIO root user; use a scoped user in production) ---
S3_REGION=us-east-1
S3_ACCESS_KEY=papertrail
S3_SECRET_KEY=change-me-local-only

# --- API: sessions, uploads, rate limits ---
SESSION_TTL_HOURS=168
UPLOAD_MAX_BYTES=15728640
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=300
# Number of reverse proxies in front of the API (0 = none). Needed for correct per-IP rate limiting behind a proxy.
TRUST_PROXY=0

# --- API: account mail ---
# console prints verification and reset links to the API log (development only; the API refuses it in production).
# smtp sends them through SMTP_URL / SMTP_FROM below.
MAILER=console

# --- Witness invites ---
WITNESS_INVITE_TTL_HOURS=72
WITNESS_RATE_LIMIT_IP=60
WITNESS_RATE_LIMIT_TOKEN=20

# --- Worker: database role, queues, reminders ---
# Least-privilege login role (member of pt_worker). Create/update it with `pnpm --filter @paper-trail/worker db:role`.
WORKER_DATABASE_URL=postgresql://papertrail_worker:change-me-worker-local-only@localhost:5432/papertrail
RETRY_DELAYS_MS=10000,60000,300000,1800000
WORKER_PREFETCH=4
# console (development) or email (needs SMTP_URL, e.g. smtps://user:pass@smtp.example.com:465)
NOTIFIER=console
# Also used by the API for account mail (verify email, reset password) when MAILER=smtp.
SMTP_URL=
SMTP_FROM=Paper Trail <no-reply@localhost>
REMINDER_TICK_SECONDS=60
