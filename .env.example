# Copy to .env (`pnpm infra:up` does this automatically). Local development values only.
# Never commit .env or real credentials.

# --- PostgreSQL ---
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=papertrail
POSTGRES_PORT=5432
DATABASE_URL=postgresql://papertrail:change-me-local-only@localhost:5432/papertrail

# --- RabbitMQ ---
RABBITMQ_USER=papertrail
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
AMQP_URL=amqp://papertrail:change-me-local-only@localhost:5672

# --- MinIO (S3-compatible file storage) ---
MINIO_ROOT_USER=papertrail
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=papertrail-files

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- RFC 3161 Time-Stamping Authority (used from the anchoring step on) ---
# Intentionally empty: choose a TSA and verify its terms of service and availability yourself.
# See docs/OPEN_DECISIONS.md.
TSA_URL=
ANCHOR_INTERVAL_MINUTES=60
