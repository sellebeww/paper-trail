{
  "name": "@paper-trail/worker",
  "version": "0.0.0",
  "private": true,
  "author": "Vassel Goleyu",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.ts",
    "anchor:now": "tsx --conditions=source --env-file-if-exists=../../.env src/cli/anchor-now.ts",
    "db:role": "tsx --env-file-if-exists=../../.env src/cli/db-role.ts",
    "mock-tsa": "tsx --env-file-if-exists=../../.env src/cli/mock-tsa.ts"
  },
  "dependencies": {
    "@paper-trail/chain": "workspace:*",
    "amqplib": "^2.2.1",
    "asn1js": "^4.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pkijs": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1"
  }
}
