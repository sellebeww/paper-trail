{
  "name": "paper-trail",
  "version": "0.1.0",
  "private": true,
  "description": "Hash-chained evidence notebook for small disputes.",
  "author": "Vassel Goleyu",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "infra:up": "test -f .env || cp .env.example .env; docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "test:int": "pnpm --filter @paper-trail/api test:int && pnpm --filter @paper-trail/worker test:int",
    "demo": "pnpm --filter @paper-trail/api demo:seed"
  },
  "devDependencies": {
    "@paper-trail/verifier": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
